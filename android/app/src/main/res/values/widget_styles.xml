<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_ink">#17130f</color>
    <color name="widget_secondary">#3a2e20</color>
    <style name="WidgetNameBase">
        <item name="android:fontFamily">@font/marhey</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetName" parent="WidgetNameBase" />
    <style name="WidgetFiguresBase">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/atkinson_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetFigures" parent="WidgetFiguresBase" />
    <style name="WidgetCellName" parent="WidgetName">
        <item name="android:textSize">9sp</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="WidgetCellState" parent="WidgetFigures">
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
